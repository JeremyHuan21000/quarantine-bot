DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
QUARANTINE_ROLE_ID=role_id_for_quarantine
MOD_ROLE_IDS=role_id_for_mods,another_mod_role_id
QUESTION_CHANNEL_ID=channel_id_where_daily_question_gets_posted
ANNOUNCE_CHANNEL_ID=channel_id_for_results_and_release_announcements
STREAK_TARGET=7

# Use quarantine-test.db for a separate test-bot instance.
DB_PATH=quarantine.db

# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_org_key
SPORTS_DATA_PROVIDER=football_data
# Used only if SPORTS_DATA_PROVIDER=thesportsdb
THESPORTSDB_API_KEY=123

# Hour (0-23, UTC) the bot auto-posts the daily question
DAILY_POST_HOUR_UTC=10
# Only auto-pick games starting more than this many hours away.
MIN_PREDICTION_LEAD_HOURS=8

# Keep true for the live bot. Use false while manually testing a second bot.
ENABLE_AUTOMATION=true

# Use true for a test bot so slash-command changes appear immediately in its server.
SYNC_GUILD_COMMANDS=false

# Relative sport selection weights (among sports with eligible games).
SPORT_WEIGHT_NHL=45
SPORT_WEIGHT_NFL=25
SPORT_WEIGHT_MLB=10
SPORT_WEIGHT_NBA=10
SPORT_WEIGHT_SOCCER=10
