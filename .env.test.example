DISCORD_TOKEN=your_test_bot_token_here
GUILD_ID=your_test_server_id_here
QUARANTINE_ROLE_ID=test_server_quarantine_role_id
MOD_ROLE_IDS=test_server_mod_role_id
QUESTION_CHANNEL_ID=test_question_channel_id
ANNOUNCE_CHANNEL_ID=test_announcement_channel_id
STREAK_TARGET=3
DB_PATH=quarantine-test.db

# The same football-data.org key can be used, but automated calls are disabled
# by default so the test bot does not duplicate the live bot's API traffic.
FOOTBALL_DATA_API_KEY=your_football_data_org_key
SPORTS_DATA_PROVIDER=thesportsdb
THESPORTSDB_API_KEY=123
# Optional: override the curated league pool with comma-separated IDs.
# SPORTSDB_LEAGUE_IDS=4328,4331,4332,4334,4335,4480,4481,5071,4490,4429,4380,4387,4391,4424
DAILY_POST_HOUR_UTC=10
ENABLE_AUTOMATION=false

# Guild-scoped commands update immediately in the test server.
SYNC_GUILD_COMMANDS=true
